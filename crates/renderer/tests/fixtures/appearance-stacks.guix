<gui version="0.2" name="Appearance stacks">
  <col w="420" h="220" fill="#F7F7F8" p="20" gap="16">
    <row w="fill" gap="16">
      <col w="120" h="80" radius="12">
        <appearance>
          <fill type="color" value="#FFFFFF" />
          <border color="#E0CFC4" w="1" align="inside" />
          <effect type="drop-shadow" x="0" y="2" radius="6" color="#0000001F" />
        </appearance>
        <text value="fill + border" font-size="12" fill="#55443C" />
      </col>

      <col w="120" h="80" radius="12" fill="#FFFFFF" border="4 #12A594">
        <appearance>
          <border color="#E5484D" w="2" align="outside" />
        </appearance>
        <text value="border wins" font-size="12" fill="#55443C" />
      </col>

      <col w="120" h="80" radius="12">
        <appearance>
          <fill type="color" value="#0D99FF" />
          <fill type="color" value="#FFFFFF66" />
          <fill type="color" value="#00000000" visible="false" />
        </appearance>
        <text value="stacked fills" font-size="12" fill="#18181B" />
      </col>
    </row>

    <row w="fill" gap="16">
      <col w="120" h="60" radius="10" fill="#FFFFFF" shadow="0 4 10 -2 #00000033">
        <text value="shadow shorthand" font-size="11" fill="#55443C" />
      </col>
      <col w="120" h="60" radius="10" fill="#FFFFFF">
        <appearance>
          <effect type="inner-shadow" x="0" y="3" radius="6" color="#00000040" />
        </appearance>
        <text value="inner shadow" font-size="11" fill="#55443C" />
      </col>
    </row>
  </col>
</gui>
