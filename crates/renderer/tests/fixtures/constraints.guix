<gui version="0.2">
  <col w="260" fill="#ffffff" p="12" gap="12">

    <!-- The horizontal constraints, each on a 24px box 10px in, against the
         same 200px parent: pinned left, pinned right, centred, and stretched
         between both edges. -->
    <frame w="200" h="34" fill="#f4f4f4">
      <rect abs x="10" y="5" w="24" h="24" fill="#0d99ff" constraint-h="left" />
    </frame>
    <frame w="200" h="34" fill="#f4f4f4">
      <rect abs x="10" y="5" w="24" h="24" fill="#0d99ff" constraint-h="right" />
    </frame>
    <frame w="200" h="34" fill="#f4f4f4">
      <rect abs x="10" y="5" w="24" h="24" fill="#0d99ff" constraint-h="center" />
    </frame>
    <frame w="200" h="34" fill="#f4f4f4">
      <rect abs x="10" y="5" w="24" h="24" fill="#0d99ff" constraint-h="stretch" />
    </frame>

    <!-- The vertical ones, in a taller parent so the three are distinct. -->
    <frame w="200" h="60" fill="#f4f4f4">
      <rect abs x="10" y="8" w="24" h="16" fill="#f2b8b5" constraint-v="top" />
      <rect abs x="44" y="8" w="24" h="16" fill="#f2b8b5" constraint-v="bottom" />
      <rect abs x="78" y="8" w="24" h="16" fill="#f2b8b5" constraint-v="center" />
      <rect abs x="112" y="8" w="24" h="16" fill="#f2b8b5" constraint-v="stretch" />
    </frame>

  </col>
</gui>
