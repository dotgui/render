<gui version="0.2" name="Text breaking">
  <!-- Declared so the text is comparable against kit: without it each
       renderer measures its own default face. -->
  <fonts><font family="Roboto" source="google" weights="400 500 600 700" styles="normal" /></fonts>
  <col w="480" h="330" fill="#FFFFFF" p="20" gap="14">
    <row w="fill" gap="20">
      <col w="130" gap="6">
        <text font-family="Roboto" w="fill" value="Pneumonoultramicroscopicsilicovolcanoconiosis" font-size="12" line-height="16" fill="#71717A" />
      </col>
      <col w="130" gap="6">
        <text font-family="Roboto" w="fill" value="Pneumonoultramicroscopicsilicovolcanoconiosis" font-size="12" line-height="16" fill="#71717A" word-break="break-all" />
      </col>
      <col w="130" gap="6">
        <text font-family="Roboto" w="fill" value="Pneumonoultramicroscopicsilicovolcanoconiosis" font-size="12" line-height="16" fill="#71717A" word-break="break-word" />
      </col>
    </row>
    <col w="fill" gap="4">
      <text font-family="Roboto" w="200" value="wraps by default across its box" font-size="12" line-height="16" fill="#18181B" />
      <text font-family="Roboto" w="200" value="white-space nowrap keeps one line" font-size="12" line-height="16" fill="#18181B" white-space="nowrap" />
      <text font-family="Roboto" w="200" value="text-wrap nowrap does the same" font-size="12" line-height="16" fill="#18181B" text-wrap="nowrap" />
      <text font-family="Roboto" w="200" value="Order AR-4827/B ships" font-size="12" line-height="16" fill="#71717A" word-break="keep-all" />
    </col>
    <text font-family="Roboto" w="fill" value="An indented first line, then the rest of the paragraph runs back to the margin as usual." paragraph-indent="28" paragraph-spacing="8" font-size="13" line-height="18" fill="#55443C" />
    <text font-family="Roboto" w="fill" value="wide word spacing here" word-spacing="10" font-size="13" fill="#18181B" />
    <text font-family="Roboto" w="fill" value="tracked out letters" letter-spacing="3" font-size="13" fill="#18181B" />
  </col>
</gui>
