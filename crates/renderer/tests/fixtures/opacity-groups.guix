<gui version="0.2" name="Group opacity">
  <row w="420" h="140" fill="#FFFFFF" p="20" gap="20">
    <frame w="100" h="100">
      <rect abs x="5" y="5" w="60" h="60" fill="#18181B" />
      <rect abs x="35" y="35" w="60" h="60" fill="#18181B" />
    </frame>
    <frame w="100" h="100" opacity="0.5">
      <rect abs x="5" y="5" w="60" h="60" fill="#18181B" />
      <rect abs x="35" y="35" w="60" h="60" fill="#18181B" />
    </frame>
    <frame w="100" h="100" opacity="0.5">
      <frame abs x="0" y="0" w="100" h="100" opacity="0.5">
        <rect abs x="5" y="5" w="90" h="90" fill="#18181B" />
      </frame>
    </frame>
    <rect w="100" h="100" fill="#E5484D" opacity="0.25" />
  </row>
</gui>
