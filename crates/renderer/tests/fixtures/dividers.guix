<gui version="0.2" name="Dividers">
  <!-- Declared so the text is comparable against kit: without it each
       renderer measures its own default face. -->
  <fonts><font family="Roboto" source="google" weights="400 500 600 700" styles="normal" /></fonts>
  <col w="460" fill="#FFFFFF" p="20" gap="0">
    <text font-family="Roboto" value="A rule takes up room" font-size="16" font-weight="700" line-height="24" fill="#111111" />

    <!-- Default thickness: one pixel, and the row below starts one lower. -->
    <line w="fill" fill="#D0D0D6" />
    <text font-family="Roboto" value="Default thickness" font-size="14" line-height="28" fill="#333333" />
    <line w="fill" fill="#D0D0D6" />
    <text font-family="Roboto" value="Another row" font-size="14" line-height="28" fill="#333333" />

    <!-- Declared thickness sizes the box, not just the stroke. -->
    <line w="fill" thickness="4" fill="#8E4EC6" />
    <text font-family="Roboto" value="Four pixels thick" font-size="14" line-height="28" fill="#333333" />

    <!-- Declared height alongside thickness: unresolved. We keep the height,
         kit overwrites it with the thickness. Here so the disagreement is
         visible in a document rather than only in an argument. -->
    <line w="fill" h="10" thickness="2" fill="#12A594" />
    <text font-family="Roboto" value="Height beats thickness" font-size="14" line-height="28" fill="#333333" />

    <!-- In a row, a horizontal rule keeps its thickness instead of stretching
         to the tallest sibling. -->
    <row w="fill" h="46" gap="12" align="middle-left">
      <rect w="60" h="40" radius="6" fill="#F5A524" />
      <line w="120" fill="#E5484D" />
      <rect w="60" h="40" radius="6" fill="#0D99FF" />
    </row>

    <!-- The same rule turned ninety degrees: thin across, and as long as the
         row is tall. kit sets out to do this too but renders it zero-height,
         so this is one of the few places the two deliberately differ. -->
    <row w="fill" h="56" gap="12">
      <rect w="60" h="56" radius="6" fill="#F5A524" />
      <line direction="vertical" fill="#E5484D" />
      <rect w="60" h="56" radius="6" fill="#0D99FF" />
      <line direction="vertical" thickness="4" fill="#12A594" />
      <rect w="60" h="56" radius="6" fill="#8E4EC6" />
    </row>
  </col>
</gui>
