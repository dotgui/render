<gui version="0.2" name="Components">
  <!-- Declared so the text is comparable against kit: without it each
       renderer measures its own default face. -->
  <fonts><font family="Roboto" source="google" weights="400 500 600 700" styles="normal" /></fonts>
  <components>
    <component name="Card/Product" id="comp-card">
      <props>
        <prop name="title" type="text" target="title" />
        <prop name="price" type="text" target="price" />
        <prop name="tint" type="color" target="chip" />
      </props>
      <col w="200" radius="12" fill="#FFFFFF" p="16" gap="6" border="1 #E4E4E7">
        <rect id="chip" w="40" h="8" radius="4" fill="#0D99FF" />
        <text font-family="Roboto" id="title" value="Product Name" font-size="15" font-weight="600" fill="#18181B" />
        <text font-family="Roboto" id="price" value="$0" font-size="13" fill="#71717A" />
        <text font-family="Roboto" id="badge" value="In stock" font-size="11" fill="#12A594" />
      </col>
    </component>
    <component-set id="set-button" name="Button">
      <variant id="btn-primary">
        <col w="120" h="36" radius="8" fill="#0D99FF" p="10">
          <text font-family="Roboto" value="Primary" font-size="13" fill="#FFFFFF" />
        </col>
      </variant>
      <variant id="btn-ghost">
        <col w="120" h="36" radius="8" fill="#FFFFFF" border="1 #D4D4D8" p="10">
          <text font-family="Roboto" value="Ghost" font-size="13" fill="#18181B" />
        </col>
      </variant>
    </component-set>
  </components>
  <col w="700" h="240" fill="#F4F4F5" p="20" gap="16">
    <row w="fill" gap="16">
      <instance component="comp-card" title="Nike Air Max 90" price="$129" />
      <instance component="comp-card" title="Adidas Samba" price="$99" tint="#E5484D" />
      <instance component="comp-card" title="No badge here" price="$59" tint="#F5A524" badge="false" />
    </row>
    <row w="fill" gap="16">
      <instance component="btn-primary" />
      <instance component="btn-ghost" />
    </row>
  </col>
</gui>
