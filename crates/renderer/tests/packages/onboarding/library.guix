<gui version="0.3" name="Onboarding library">
  <tokens>
    <color name="bg" value="#F4F1EA" />
    <color name="surface" value="#FFFFFF" />
    <color name="ink" value="#1C1B19" />
    <color name="muted" value="#6B675E" />
    <color name="line" value="#E7E2D8" />
    <color name="primary" value="#2F5BEA" />
    <color name="on-primary" value="#FFFFFF" />
    <color name="accent" value="#E8572A" />
  </tokens>
  <fonts>
    <font family="Inter" source="google" weights="400 500 600 700" styles="normal" />
  </fonts>
  <styles>
    <text-style name="Title" font-family="Inter" font-size="28" font-weight="700" line-height="34" />
    <text-style name="Body" font-family="Inter" font-size="15" font-weight="400" line-height="22" />
    <text-style name="Label" font-family="Inter" font-size="15" font-weight="600" line-height="20" />
    <text-style name="Caption" font-family="Inter" font-size="12" font-weight="500" line-height="16" />
  </styles>
  <components>
    <component-set id="compset-button" name="Button">
      <variant id="comp-button-primary" name="Button/Primary">
        <props>
          <prop name="label" type="string" target="label" />
        </props>
        <row h="48" p="0 20" radius="12" fill="$primary" align="middle-center">
          <text id="label" text-style="Label" value="Continue" fill="$on-primary" />
        </row>
      </variant>
      <variant id="comp-button-secondary" name="Button/Secondary">
        <props>
          <prop name="label" type="string" target="label" />
        </props>
        <row h="48" p="0 20" radius="12" fill="$surface" border="1 $line" align="middle-center">
          <text id="label" text-style="Label" value="Cancel" fill="$ink" />
        </row>
      </variant>
    </component-set>

    <component-set id="compset-tab" name="Tab">
      <variant id="comp-tab" name="Tab/Default">
        <props>
          <prop name="label" type="string" target="label" />
        </props>
        <col w="fill" gap="4" align="top-center">
          <rect w="24" h="24" radius="6" fill="$line" />
          <text id="label" text-style="Caption" value="Tab" fill="$muted" />
        </col>
      </variant>
      <variant id="comp-tab-active" name="Tab/Active">
        <props>
          <prop name="label" type="string" target="label" />
        </props>
        <col w="fill" gap="4" align="top-center">
          <rect w="24" h="24" radius="6" fill="$primary" />
          <text id="label" text-style="Caption" value="Tab" fill="$primary" />
        </col>
      </variant>
    </component-set>

    <component id="comp-card" name="Card">
      <props>
        <prop name="heading" type="string" target="heading" />
      </props>
      <col w="fill" p="16" gap="8" radius="16" fill="$surface" border="1 $line">
        <text id="heading" text-style="Label" value="Card" fill="$ink" />
        <col slot="content" w="fill" gap="6" />
      </col>
    </component>

    <!-- The scaffold every screen shares: only its middle differs. -->
    <component id="comp-screen" name="Screen">
      <props>
        <prop name="title" type="string" target="title" />
      </props>
      <col w="390" h="844" fill="$bg">
        <row w="fill" h="44" p="0 24" align="middle-left">
          <text text-style="Label" value="9:41" fill="$ink" />
        </row>
        <col w="fill" p="16 24 0">
          <text id="title" text-style="Title" value="Title" fill="$ink" w="fill" />
        </col>
        <col slot="body" w="fill" h="fill" p="24" gap="16" />
        <col slot="actions" w="fill" p="0 24 16" gap="12">
          <instance component="comp-button-primary" label="Continue" w="fill" />
        </col>
        <row slot="tabs" slot-accept="compset-tab" slot-min="2" slot-max="5" w="fill" p="8 16 24" gap="8" fill="$surface" border="1 $line" />
      </col>
    </component>
  </components>

  <!-- Local to this file: the library's own page, a style guide for the above. -->
  <col w="900" p="48" gap="32" fill="$bg">
    <text text-style="Title" value="Onboarding library" fill="$ink" />
    <col gap="12">
      <text text-style="Label" value="Colour" fill="$muted" />
      <row gap="12">
        <rect w="64" h="64" radius="12" fill="$bg" border="1 $line" />
        <rect w="64" h="64" radius="12" fill="$surface" border="1 $line" />
        <rect w="64" h="64" radius="12" fill="$ink" />
        <rect w="64" h="64" radius="12" fill="$muted" />
        <rect w="64" h="64" radius="12" fill="$primary" />
        <rect w="64" h="64" radius="12" fill="$accent" />
      </row>
    </col>
    <col gap="12">
      <text text-style="Label" value="Buttons" fill="$muted" />
      <row gap="12">
        <instance component="comp-button-primary" label="Primary" />
        <instance component="comp-button-secondary" label="Secondary" />
      </row>
    </col>
    <col gap="12">
      <text text-style="Label" value="Tabs" fill="$muted" />
      <row w="360" gap="8">
        <instance component="comp-tab-active" label="Home" />
        <instance component="comp-tab" label="Search" />
        <instance component="comp-tab" label="Profile" />
      </row>
    </col>
    <col w="360" gap="12">
      <text text-style="Label" value="Card" fill="$muted" />
      <instance component="comp-card" heading="Card with content">
        <slot name="content">
          <text text-style="Body" value="Anything can go in a card's content slot." fill="$muted" w="fill" />
        </slot>
      </instance>
    </col>

    <!-- The page template, shown with its slots marked. -->
    <col gap="16">
      <text text-style="Label" value="Templates" fill="$muted" />
      <col w="804" gap="4">
        <text text-style="Label" value="Screen · comp-screen" fill="$ink" />
        <text text-style="Body" value="The page template every screen in this package is built on. The status bar and title stay in place; the middle changes per screen. Prop: title. Slots: body; actions, which falls back to a Continue button; tabs, which accepts only tabs (2 to 5). A slot left empty takes no space." fill="$muted" w="fill" />
      </col>
      <row gap="24" align="top-left">
        <col gap="8">
          <text text-style="Caption" value="Body filled · actions fall back · no tabs" fill="$muted" />
          <col radius="24" border="1 $line" clip>
          <instance component="comp-screen" title="Title prop">
            <slot name="body">
              <row w="fill" h="fill" radius="12" border-width="1" border-color="$muted" border-style="dashed" align="middle-center">
                  <text text-style="Caption" value="body slot" fill="$muted" />
                </row>
            </slot>
          </instance>
          </col>
        </col>
        <col gap="8">
          <text text-style="Caption" value="Every slot filled" fill="$muted" />
          <col radius="24" border="1 $line" clip>
          <instance component="comp-screen" title="Title prop">
            <slot name="body">
              <row w="fill" h="fill" radius="12" border-width="1" border-color="$muted" border-style="dashed" align="middle-center">
                  <text text-style="Caption" value="body slot" fill="$muted" />
                </row>
            </slot>
            <slot name="actions">
              <row w="fill" h="48" radius="12" border-width="1" border-color="$muted" border-style="dashed" align="middle-center">
                  <text text-style="Caption" value="actions slot" fill="$muted" />
                </row>
            </slot>
            <slot name="tabs">
              <instance component="comp-tab-active" label="Tab" />
              <instance component="comp-tab" label="Tab" />
              <instance component="comp-tab" label="Tab" />
            </slot>
          </instance>
          </col>
        </col>
      </row>
    </col>
  </col>
</gui>
