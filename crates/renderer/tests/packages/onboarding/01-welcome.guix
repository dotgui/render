<gui version="0.3" name="Welcome">
  <col w="390" h="844">
    <instance component="comp-screen" title="Welcome to Onda">
      <slot name="body">
        <rect w="fill" h="240" radius="24" fill="$primary" />
        <img src="assets/logo.svg" w="48" h="48" />
        <text text-style="Body" value="Plan trips with the people you travel with. No tabs yet: this screen leaves that slot unfilled, and it takes no space." color="$muted" w="fill" />
      </slot>
    </instance>
  </col>
</gui>
